rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Documents collection and subcollections
    match /documents/{docId} {
      allow read, write: if true;

      match /users/{userId} {
        allow read, write: if true;
      }
    }

    // User profiles and rooms subcollections
    match /users/{userEmail} {
      allow read, write: if true;

      match /rooms/{roomId} {
        allow read, write: if true;
      }
    }

    // Collection group for rooms
    match /{path=**}/rooms/{roomId} {
      allow read, write: if true;
    }
  }
}
